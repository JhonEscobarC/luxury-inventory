generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONTABILIDAD
  OBRA
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  DESPACHADO
  CANCELADO
}

enum EtapaStatus {
  PENDIENTE
  COMPLETADA
  PAGADA
}

// Los valores internos se mantienen (PENDIENTE/CONFIRMADO/DESPACHADO) para no romper
// datos ni migraciones existentes; en toda la interfaz se muestran como
// Solicitud / Compra / Recibido respectivamente.
enum FormaPago {
  CONTADO
  CREDITO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum GastoTipo {
  GENERAL
  EMPLEADO
}

enum ProductoHistorialTipo {
  CREADO
  INGRESO
  USO
  EDITADO
}

enum HistorialTipo {
  PEDIDO_CREADO
  PEDIDO_CONFIRMADO
  PEDIDO_DESPACHADO
  PEDIDO_CANCELADO
  ASIGNACION_CREADA
  ETAPA_COMPLETADA
  ETAPA_PAGADA
  ABONO_REGISTRADO
  MATERIAL_USADO
  ABONO_CLIENTE_REGISTRADO
  GASTO_ADICIONAL_REGISTRADO
  PRESTAMO_REGISTRADO
  PRESTAMO_PAGO_REGISTRADO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OBRA)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated          Order[]          @relation("OrderCreatedBy")
  ordersAssigned         Order[]          @relation("OrderAssignedBy")
  obras                  Obra[]           @relation("UserObras")
  abonosCreated          Abono[]          @relation("AbonoCreatedBy")
  abonosClienteCreated   AbonoCliente[]   @relation("AbonoClienteCreatedBy")
  materialUsos           MaterialUso[]
  gastosAdicionalesCreated GastoAdicional[] @relation("GastoAdicionalCreatedBy")
  recepcionesCreated     OrderRecepcion[] @relation("OrderRecepcionBy")
  prestamosCreated       Prestamo[]       @relation("PrestamoCreatedBy")
  prestamoPagosCreated   PrestamoPago[]   @relation("PrestamoPagoCreatedBy")

  @@map("users")
}

model Categoria {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  orderItems OrderItem[]

  @@map("categorias")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  unit      String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  // El inventario ahora se maneja por obra: un producto sin obraId es stock general
  // (visible para ADMIN/CONTABILIDAD); uno con obraId solo pertenece a esa obra.
  obraId String?
  obra   Obra?   @relation(fields: [obraId], references: [id], onDelete: SetNull)

  orderItems   OrderItem[]
  materialUsos MaterialUso[]
  historial    ProductoHistorial[]

  @@index([categoriaId])
  @@index([obraId])
  @@map("products")
}

// Bitacora de cada producto: cuando se agrego, cada ingreso por pedido, cada uso y
// cada edicion. No guarda precios (la ven tambien los residentes).
model ProductoHistorial {
  id                 String                @id @default(uuid())
  tipo               ProductoHistorialTipo
  descripcion        String
  cantidad           Decimal?              @db.Decimal(12, 2)
  cantidadResultante Decimal?              @db.Decimal(12, 2)
  userName           String?
  createdAt          DateTime              @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("producto_historial")
}

model Proyecto {
  id        String   @id @default(uuid())
  name      String
  client    String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obras Obra[]

  @@map("proyectos")
}

model Obra {
  id          String   @id @default(uuid())
  name        String
  address     String?
  client      String?
  notes       String?
  // Precio de venta acordado con el comprador (client); null si la obra no esta en venta.
  precioVenta Decimal? @db.Decimal(14, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proyectoId String?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  users  User[]  @relation("UserObras")
  orders Order[]

  contratistaAsignaciones ContratistaAsignacion[]
  products                Product[]
  materialUsos            MaterialUso[]
  abonosCliente           AbonoCliente[]
  gastosAdicionales       GastoAdicional[]
  etapas                  ObraEtapa[]

  @@map("obras")
}

// Etapas de construccion de una obra (Trabajos preliminares, Estructura, etc). Cada obra
// tiene su propia copia mutable: al crear la obra se le clonan las etapas por defecto
// (isCustom = false) y desde ahi el orden y las etapas adicionales (isCustom = true) son
// independientes por obra.
model ObraEtapa {
  id        String   @id @default(uuid())
  name      String
  order     Int
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  orderItems        OrderItem[]
  contratistaEtapas ContratistaEtapa[]
  materialUsos      MaterialUso[]

  @@index([obraId])
  @@map("obra_etapas")
}

model MaterialUso {
  id        String   @id @default(uuid())
  quantity  Decimal  @db.Decimal(12, 2)
  reason    String
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // A que etapa de construccion de la obra va destinado este uso de material.
  obraEtapaId String
  obraEtapa   ObraEtapa @relation(fields: [obraEtapaId], references: [id])

  @@index([obraId])
  @@index([productId])
  @@map("material_usos")
}

model Contratista {
  id        String   @id @default(uuid())
  name      String
  oficio    String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones ContratistaAsignacion[]

  @@map("contratistas")
}

model ContratistaAsignacion {
  id            String   @id @default(uuid())
  totalAmount   Decimal  @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id])

  contratistaId String
  contratista   Contratista @relation(fields: [contratistaId], references: [id])

  etapas ContratistaEtapa[]

  @@map("contratista_asignaciones")
}

model ContratistaEtapa {
  id          String      @id @default(uuid())
  name        String
  percentage  Decimal     @db.Decimal(5, 2)
  status      EtapaStatus @default(PENDIENTE)
  completedAt DateTime?
  paidAt      DateTime?
  // Con que medio se pago esta cuota (se pide al marcarla como pagada).
  metodoPago  MetodoPago?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  asignacionId String
  asignacion   ContratistaAsignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)

  // A que etapa de construccion de la obra corresponde esta cuota de pago (opcional).
  obraEtapaId String?
  obraEtapa   ObraEtapa? @relation(fields: [obraEtapaId], references: [id], onDelete: SetNull)

  @@map("contratista_etapas")
}

model Proveedor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  category    String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders     Order[]
  orderItems OrderItem[]
  products   Product[]
  abonos     Abono[]

  @@map("proveedores")
}

model Abono {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  // Nulo en abonos registrados antes de agregar este campo.
  metodoPago MetodoPago?
  createdAt DateTime @default(now())

  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  createdById String?
  createdBy   User?   @relation("AbonoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("abonos")
}

// Pagos que hace el comprador de una obra (casa) hacia su precio de venta.
// Distinto de Abono, que es lo que la empresa le paga a un Proveedor.
model AbonoCliente {
  id         String      @id @default(uuid())
  amount     Decimal     @db.Decimal(14, 2)
  notes      String?
  // Nulos en abonos registrados antes de agregar estos campos.
  formaPago  FormaPago?
  metodoPago MetodoPago?
  createdAt  DateTime    @default(now())

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id])

  createdById String?
  createdBy   User?   @relation("AbonoClienteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("abonos_cliente")
}

// Gastos varios de la empresa que no encajan como pedido a proveedor ni pago a
// contratista (ej. transporte, tramites, papeleria). Opcionalmente se asocian a una obra.
model GastoAdicional {
  id         String     @id @default(uuid())
  concepto   String
  amount     Decimal    @db.Decimal(14, 2)
  metodoPago MetodoPago
  notes      String?
  // GENERAL = gasto varios de la empresa; EMPLEADO = pago a un empleado (empleadoNombre
  // guarda el nombre, escrito libremente cada vez; no hay un registro de empleados).
  tipo           GastoTipo @default(GENERAL)
  empleadoNombre String?
  createdAt  DateTime   @default(now())

  obraId String?
  obra   Obra?   @relation(fields: [obraId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("GastoAdicionalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("gastos_adicionales")
}

// Dinero recibido en prestamo (ingreso). Se le puede ir abonando (PrestamoPago, un
// egreso) hasta saldar la deuda, igual que un Proveedor con sus Abonos.
model Prestamo {
  id         String     @id @default(uuid())
  amount     Decimal    @db.Decimal(14, 2)
  lender     String
  notes      String?
  metodoPago MetodoPago
  createdAt  DateTime   @default(now())

  createdById String?
  createdBy   User?   @relation("PrestamoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  pagos PrestamoPago[]

  @@map("prestamos")
}

model PrestamoPago {
  id         String     @id @default(uuid())
  amount     Decimal    @db.Decimal(14, 2)
  metodoPago MetodoPago
  notes      String?
  createdAt  DateTime   @default(now())

  prestamoId String
  prestamo   Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("PrestamoPagoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("prestamo_pagos")
}

model Order {
  id        String      @id @default(uuid())
  status    OrderStatus @default(PENDIENTE)
  notes     String?
  formaPago FormaPago?

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id])

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignedById String?
  assignedBy   User?   @relation("OrderAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  items      OrderItem[]
  recepcion  OrderRecepcion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// Foto que sube el residente como prueba de que el pedido llego. Se guarda en la base
// de datos (el disco del servidor no es persistente) y se sirve por un endpoint aparte.
model OrderRecepcion {
  id        String   @id @default(uuid())
  foto      Bytes
  mime      String
  createdAt DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("OrderRecepcionBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("order_recepciones")
}

model HistorialEvento {
  id          String        @id @default(uuid())
  tipo        HistorialTipo
  descripcion String
  monto       Decimal?      @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())

  userName String?

  obraId   String?
  obraName String?

  proveedorId   String?
  proveedorName String?

  contratistaId   String?
  contratistaName String?

  orderId          String?
  asignacionId     String?
  abonoId          String?
  abonoClienteId   String?
  gastoAdicionalId String?
  prestamoId       String?
  prestamoPagoId   String?

  @@index([createdAt])
  @@index([obraId])
  @@index([proveedorId])
  @@map("historial_eventos")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal? @db.Decimal(12, 2)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Solo se usa cuando el pedido asigna un proveedor distinto por material; si el
  // pedido usa un unico proveedor, este queda null y se usa Order.proveedorId.
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  // A que etapa de construccion de la obra va destinado este material.
  obraEtapaId String
  obraEtapa   ObraEtapa @relation(fields: [obraEtapaId], references: [id])

  @@map("order_items")
}
