generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONTABILIDAD
  OBRA
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  DESPACHADO
  CANCELADO
}

enum EtapaStatus {
  PENDIENTE
  COMPLETADA
  PAGADA
}

enum HistorialTipo {
  PEDIDO_CREADO
  PEDIDO_CONFIRMADO
  PEDIDO_DESPACHADO
  PEDIDO_CANCELADO
  ASIGNACION_CREADA
  ETAPA_COMPLETADA
  ETAPA_PAGADA
  ABONO_REGISTRADO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OBRA)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated  Order[] @relation("OrderCreatedBy")
  ordersAssigned Order[] @relation("OrderAssignedBy")
  obras          Obra[]  @relation("UserObras")
  abonosCreated  Abono[] @relation("AbonoCreatedBy")

  @@map("users")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  unit      String
  price     Decimal  @db.Decimal(12, 2)
  minStock  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([category])
  @@map("products")
}

model Proyecto {
  id        String   @id @default(uuid())
  name      String
  client    String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obras Obra[]

  @@map("proyectos")
}

model Obra {
  id        String   @id @default(uuid())
  name      String
  address   String?
  client    String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proyectoId String?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  users  User[]  @relation("UserObras")
  orders Order[]

  contratistaAsignaciones ContratistaAsignacion[]

  @@map("obras")
}

model Contratista {
  id        String   @id @default(uuid())
  name      String
  oficio    String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones ContratistaAsignacion[]

  @@map("contratistas")
}

model ContratistaAsignacion {
  id            String   @id @default(uuid())
  totalAmount   Decimal  @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id])

  contratistaId String
  contratista   Contratista @relation(fields: [contratistaId], references: [id])

  etapas ContratistaEtapa[]

  @@map("contratista_asignaciones")
}

model ContratistaEtapa {
  id          String      @id @default(uuid())
  name        String
  percentage  Decimal     @db.Decimal(5, 2)
  status      EtapaStatus @default(PENDIENTE)
  completedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  asignacionId String
  asignacion   ContratistaAsignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)

  @@map("contratista_etapas")
}

model Proveedor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  category    String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders   Order[]
  products Product[]
  abonos   Abono[]

  @@map("proveedores")
}

model Abono {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  createdAt DateTime @default(now())

  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  createdById String?
  createdBy   User?   @relation("AbonoCreatedBy", fields: [createdById], references: [id])

  @@map("abonos")
}

model Order {
  id     String      @id @default(uuid())
  status OrderStatus @default(PENDIENTE)
  notes  String?

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id])

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignedById String?
  assignedBy   User?   @relation("OrderAssignedBy", fields: [assignedById], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model HistorialEvento {
  id          String        @id @default(uuid())
  tipo        HistorialTipo
  descripcion String
  monto       Decimal?      @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())

  userName String?

  obraId   String?
  obraName String?

  proveedorId   String?
  proveedorName String?

  contratistaId   String?
  contratistaName String?

  orderId      String?
  asignacionId String?
  abonoId      String?

  @@index([createdAt])
  @@index([obraId])
  @@index([proveedorId])
  @@map("historial_eventos")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal? @db.Decimal(12, 2)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
