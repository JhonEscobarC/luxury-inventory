generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BODEGA
  VENTAS
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  DESPACHADO
  CANCELADO
}

enum OrderSource {
  MANUAL
  WHATSAPP
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VENTAS)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated Order[] @relation("OrderCreatedBy")

  @@map("users")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  unit      String
  price     Decimal  @db.Decimal(12, 2)
  supplier  String?
  minStock  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
  @@map("products")
}

model Order {
  id            String      @id @default(uuid())
  status        OrderStatus @default(PENDIENTE)
  source        OrderSource @default(MANUAL)
  customerName  String?
  customerPhone String?
  notes         String?

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  items        OrderItem[]
  whatsappLogs WhatsAppMessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  @@map("order_items")
}

model WhatsAppMessageLog {
  id          String            @id @default(uuid())
  waMessageId String?           @unique
  fromNumber  String
  toNumber    String
  direction   WhatsAppDirection
  body        String
  rawPayload  Json?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@map("whatsapp_message_logs")
}
