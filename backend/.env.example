PORT=4000
NODE_ENV=development

# Debe coincidir con docker-compose.yml (o tu instancia local de Postgres)
DATABASE_URL="postgresql://luxury:luxury@localhost:5432/luxury_inventory?schema=public"

# Autenticacion
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# CORS: origen del frontend en desarrollo
CORS_ORIGIN="http://localhost:5173"

# --- WhatsApp Business Cloud API (Meta) ---
# Se dejan preparadas para el modulo de pedidos por WhatsApp (aun no conectado)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
